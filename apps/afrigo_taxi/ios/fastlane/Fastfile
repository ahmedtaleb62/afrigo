# Builds the Taxi (driver) app and uploads it to TestFlight. Signing is
# handled by match, backed by a private git repo of encrypted certs/profiles.
# `readonly` is intentionally left false (not just on the first run) —
# there's no Mac available to seed the match repo locally, so CI itself
# creates the Distribution cert + provisioning profile the first time it
# runs and pushes them (encrypted with MATCH_PASSWORD) to the match repo;
# every run after that just finds them there and reuses them rather than
# creating anew. Auth to App Store Connect uses an API key (no Apple
# ID/password/2FA in CI).
default_platform(:ios)

platform :ios do
  desc "Build and upload a new build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    setup_ci if ENV["CI"]

    match(
      type: "appstore",
      api_key: api_key,
      readonly: false,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "com.afrigo.taxi",
      profile_name: ENV["sigh_com.afrigo.taxi_appstore_profile-name"],
    )

    build_number = (latest_testflight_build_number(api_key: api_key) + 1).to_s
    increment_build_number(xcodeproj: "Runner.xcodeproj", build_number: build_number)

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "build",
      xcodebuild_formatter: "",
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Push App Store Connect listing metadata (no binary/screenshots)"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    # Afrigo Taxi has no violence/sexual/gambling/mature content, no ads,
    # no social features, no user-generated content visible to other
    # users — every descriptor is genuinely "none"/false for a driver
    # utility app.
    app_info = Spaceship::ConnectAPI::App.find("com.afrigo.taxi").fetch_edit_app_info

    # deliver's own "activate version language" step auto-creates the
    # App Info localization for any new locale using the primary
    # locale's name verbatim, which collides with an unrelated app
    # already registered as "Afrigo Taxi" — pre-create it ourselves with
    # a disambiguated name so deliver just finds and reuses it instead.
    unless app_info.get_app_info_localizations.any? { |l| l.locale == "fr-FR" }
      app_info.create_app_info_localization(attributes: {
        locale: "fr-FR",
        name: "Afrigo Taxi Mauritanie",
        subtitle: "Application chauffeurs",
      })
    end

    rating = app_info.fetch_age_rating_declaration
    rating.update(attributes: {
      alcoholTobaccoOrDrugUseOrReferences: "NONE",
      contests: "NONE",
      gamblingSimulated: "NONE",
      gunsOrOtherWeapons: "NONE",
      horrorOrFearThemes: "NONE",
      matureOrSuggestiveThemes: "NONE",
      medicalOrTreatmentInformation: "NONE",
      profanityOrCrudeHumor: "NONE",
      sexualContentGraphicAndNudity: "NONE",
      sexualContentOrNudity: "NONE",
      violenceCartoonOrFantasy: "NONE",
      violenceRealisticProlongedGraphicOrSadistic: "NONE",
      violenceRealistic: "NONE",
      advertising: false,
      ageAssurance: false,
      gambling: false,
      healthOrWellnessTopics: false,
      lootBox: false,
      messagingAndChat: false,
      parentalControls: false,
      socialMedia: false,
      socialMediaAgeRestricted: false,
      unrestrictedWebAccess: false,
      userGeneratedContent: false,
    })

    # demo_user/demo_password are a real driver account's login (not
    # throwaway dummy data) so they're never written to
    # metadata/review_information — this repo is public. Passed as
    # CI-only secrets instead.
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      # Afrigo Taxi has no in-app purchases, and precheck can't inspect
      # IAPs via API-key auth anyway (a known fastlane limitation, not a
      # real problem with our metadata) — would otherwise hard-fail
      # every run.
      run_precheck_before_submit: false,
      app_review_information: {
        first_name: "Ahmed",
        last_name: "Taleb",
        phone_number: "+222 42740370",
        email_address: "ahmedelkentawi@gmail.com",
        demo_user: ENV["ASC_DEMO_USER"],
        demo_password: ENV["ASC_DEMO_PASSWORD"],
        notes: "To sign in, use the Login screen (not Sign Up) with the demo phone number and password provided in App Review Information. This is a pre-verified driver account with an already-approved vehicle, so the reviewer lands directly on the driver Home/dashboard rather than the pending-approval screen. No SMS/OTP code is required. The app's default language is Arabic (right-to-left); a language toggle (Arabic/French) is available from the Profile screen. Please allow location access when prompted — it's required to go Online and receive ride requests.",
      },
    )
  end
end
